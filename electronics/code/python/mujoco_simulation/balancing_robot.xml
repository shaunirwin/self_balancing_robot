<mujoco model="simple_balancing_robot">
    <default>
        <!-- convert the Onshape coordinate system to MuJoCo -->
        <!--<geom type="mesh" xyaxes="1 0 0 0 0 1"/> -->
        <geom type="mesh" xyaxes="1 0 0 0 1 0"/>
    </default>

    <!-- Haze -->
    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="120" elevation="-20" />
    </visual>

    <asset>
        <!-- Onshape outputs meshes with mm units by default, but must be converted to m in MuJoCo, hence the scaling -->
        <mesh name="body" file="body_v1.stl" scale="0.001 0.001 0.001"/>
        <mesh name="wheelL" file="wheel_L_v1.stl" scale="0.001 0.001 0.001"/>
        <mesh name="wheelR" file="wheel_R_v1.stl" scale="0.001 0.001 0.001"/>

        <!-- Sky -->
        <texture type="skybox" builtin="gradient" rgb1="0.1 0.2 0.3" rgb2="0 0 0" width="512"
            height="3072" />
        <!-- Ground -->
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.3 0.4 0.5"
            rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8"
            reflectance="0.2" />
    </asset>
    <worldbody>
        <light diffuse="0.5 0.5 0.5" pos="0 0 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -0.031" group="1" material="groundplane" />
        <body name="body">
            <inertial pos="0.001 0.0 0.15" mass="0.9" diaginertia="0.001311 0.0012568 0.000487" />     <!-- offset slightly in front to break symmetry -->
            <geom mesh="body" rgba="0.8 0.1 0.1 1" />
            <joint name="joint_robot_body" type="free"/>
            <body name="wheelL">
                <inertial pos="0 0 0" mass="0.032" diaginertia="0.001311 0.0012568 0.000487"/>
                <geom mesh="wheelL" rgba="0.1 0.8 0.1 1"/>
                <joint name="joint_wheel_L" axis="0 1 0" type="hinge" damping="0.1"/>
            </body>
            <body name="wheelR">
                <inertial pos="0 0 0" mass="0.032" diaginertia="0.001311 0.0012568 0.000487"/>
                <geom mesh="wheelR" rgba="0.1 0.1 0.8 1"/>
                <joint name="joint_wheel_R" axis="0 1 0" type="hinge" damping="0.1"/>
            </body>
        </body>
    </worldbody>
    <actuator>
        <motor name="motor_L" joint="joint_wheel_L" />
        <motor name="motor_R" joint="joint_wheel_R" />
    </actuator>

    <option timestep="0.001" />
    <option gravity="0 0 -9.81" />

</mujoco>